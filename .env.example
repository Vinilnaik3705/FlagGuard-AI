FLAGGUARD_API_KEY=replace-with-random-secret
FLAGGUARD_DB=flagguard.db

FLAGGUARD_TELEMETRY_KEY=replace-with-different-random-secret
FLAGGUARD_REQUIRE_SEPARATE_KEYS=true
FLAGGUARD_ENABLE_WRITES=false

# Optional read-only viewer key; must differ from administrator and telemetry keys.
FLAGGUARD_VIEWER_KEY=
